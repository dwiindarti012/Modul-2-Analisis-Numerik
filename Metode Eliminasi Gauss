import numpy as np

# DATA: Sistem Persamaan Linear (SPL) Ax = b
#   3x1 + 1x2 - 4x3 = 7
#  -2x1 + 3x2 + 1x3 = -5
#   2x1 + 0x2 + 5x3 = 10
A = np.array([[3.0, 1.0, -4.0],
              [-2.0, 3.0, 1.0],
              [2.0, 0.0, 5.0]])   # matriks koefisien

b = np.array([7.0, -5.0, 10.0])   # vektor konstanta (ruas kanan)


def eliminasi_gauss(A, b):
  n = len(b)  # jumlah persamaan / variabel

  # LANGKAH 1: Bentuk matriks augmented [A | b]
  # b diubah jadi kolom (reshape) lalu ditempel di sisi kanan A
  Ab = np.hstack([A, b.reshape(-1, 1)])

  print("=== Matriks Augmented Awal ===")
  print(Ab)
  print("=" * 45)

  # LANGKAH 2: ELIMINASI MAJU (Forward Elimination)
  # Tujuan: ubah matriks jadi segitiga atas
  # (semua angka di bawah diagonal utama jadi 0)
  for i in range(n):  # i = kolom/baris pivot yang sedang diproses

    # Ambil elemen diagonal sebagai pivot
    pivot = Ab[i, i]

    # Cek pivot: kalau 0, kita tidak bisa bagi (pembagian dengan nol)
    # Catatan: kode ini belum pakai pivoting (tukar baris)
    if abs(pivot) < 1e-12:
      print(f"Error: Pivot bernilai nol pada baris {i + 1}.")
      return None

    # Nolkan semua elemen di BAWAH pivot pada kolom i
    for j in range(i + 1, n):  # j = baris-baris di bawah baris pivot
      # faktor pengali, supaya elemen Ab[j, i] jadi 0
      faktor = Ab[j, i] / Ab[i, i]

      # Operasi Baris Elementer (OBE): R_j = R_j - faktor * R_i
      # Dimulai dari kolom i (kolom sebelumnya sudah 0, jadi tak perlu dihitung)
      Ab[j, i:] = Ab[j, i:] - faktor * Ab[i, i:]

    # Tampilkan matriks setelah satu kolom selesai dieliminasi
    print(f"Setelah Eliminasi Kolom {i + 1}:")
    print(Ab)
    print("-" * 45)

  # LANGKAH 3: SUBSTITUSI MUNDUR (Back Substitution)
  # Matriks sudah segitiga atas, jadi variabel dicari dari baris paling bawah ke atas (x3 dulu, lalu x2, lalu x1)
  x = np.zeros(n)  # tempat menyimpan hasil solusi
  for i in range(n - 1, -1, -1):  # loop mundur: n-1, ..., 1, 0
    # Rumus: x_i = (b_i - jumlah(koefisien * x yang sudah diketahui)) / koefisien x_i
    # np.dot(...) menghitung jumlah koefisien kali x yang sudah ketemu
    x[i] = (Ab[i, -1] - np.dot(Ab[i, i + 1 : n], x[i + 1 : n])) / Ab[i, i]

  return x


# MENJALANKAN PROGRAM & MENAMPILKAN HASIL
hasil_solusi = eliminasi_gauss(A, b)

# Tampilkan hanya kalau eliminasi berhasil (tidak None)
if hasil_solusi is not None:
  print("\n=== Hasil Solusi Akhir ===")
  print(f"x1 = {hasil_solusi[0]:.4f}  (Pecahan: 260/81)")
  print(f"x2 = {hasil_solusi[1]:.4f}  (Pecahan: 19/81)")
  print(f"x3 = {hasil_solusi[2]:.4f}  (Pecahan: 58/81)")
